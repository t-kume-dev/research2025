# Unity standard gitignore
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[_Bb]uilds/
_builds/
_builds/**
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# Memory Dumps
*.lspd
*.cltf
*.log
*.tmp

# VS Code and Visual Studio files
.vs/
.idea/
*.sln
*.csproj
*.unityproj
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.opendb
*.VC.db

# OS generated files
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# Certificates and their metas
*.pfx
*.pfx.meta
*.pem
*.key

# Unity temporary/system files
~UnityDirMonSyncFile~*
*~

